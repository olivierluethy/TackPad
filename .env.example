# Copy to .env for local (non-Docker) development. The Docker entrypoint
# generates this file automatically from docker-compose environment variables,
# so you do NOT need to create it when running `docker compose up`.

# Database connection
DB_SERVER=127.0.0.1
DB_USERNAME=tackpad
DB_PASSWORD=tackpad
DB_NAME=TackPad

# 32-byte key used for AES-256-CBC encryption of task fields.
# Generate a real one with: openssl rand -hex 16
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef
